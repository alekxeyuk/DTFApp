<Page
    x:Class="DTFApp.Views.EntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Uid="BackButton" Grid.Column="0" Content="&lt; Back" Click="BackButton_Click"/>

            <Button Grid.Column="2" Click="CommentsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE90A;" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ViewModel.CommentsCount}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Uid="ShareButton" Grid.Column="3" Margin="5,0,0,0" Click="ShareButton_Click">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72D;"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="EntryScrollViewer">
                <StackPanel x:Name="BlocksPanel" Margin="10" />
            </ScrollViewer>
            <StackPanel
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="{Binding ViewModel.ErrorVisibility}">
                <TextBlock
                    x:Uid="ErrorText"
                    FontSize="14"
                    Foreground="Gray"
                    Text="{Binding ViewModel.ErrorMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False"/>
                <Button
                    x:Uid="RetryButton"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Content="Retry"
                    Click="RetryButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
