<Page
    x:Class="DTFApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button
                x:Uid="BackButton"
                Grid.Column="0"
                Content="&lt; Back"
                Click="BackButton_Click"/>
            <TextBlock
                x:Uid="SettingsTitle"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Settings"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16">
            <ToggleSwitch
                x:Name="AutoplayGifsToggle"
                x:Uid="AutoplayGifsToggle"
                Header="Autoplay GIFs"
                Toggled="AutoplayGifsToggle_Toggled"/>
            <ToggleSwitch
                x:Name="LowDataToggle"
                x:Uid="LowDataModeToggle"
                Header="Low data mode (smaller images)"
                Toggled="LowDataToggle_Toggled"/>
        </StackPanel>
    </Grid>
</Page>
